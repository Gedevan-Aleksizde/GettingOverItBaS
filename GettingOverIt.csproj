<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GameManaged Condition="'$(GameManaged)' == ''">C:/Program Files (x86)/Steam/steamapps/common/Blade &amp; Sorcery/BladeAndSorcery_Data/Managed</GameManaged>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src/**/*.cs" />
    <Reference Include="$(GameManaged)/ThunderRoad.dll" Private="false" />
    <Reference Include="$(GameManaged)/ThunderRoad.Manikin.dll" Private="false" />
    <Reference Include="$(GameManaged)/Newtonsoft.Json.dll" Private="false" />
    <Reference Include="$(GameManaged)/UnityEngine*.dll" Private="false" />
    <Reference Include="$(GameManaged)/Unity.ResourceManager.dll" Private="false" />
    <Reference Include="$(GameManaged)/Unity.Addressables.dll" Private="false" />
  </ItemGroup>
  <Target Name="PackageMod" AfterTargets="Build">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)/tools/package.ps1&quot; -Dll &quot;$(TargetPath)&quot;" />
  </Target>
</Project>
